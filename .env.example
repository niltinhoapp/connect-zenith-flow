# ConnectWeb Automations — variáveis de ambiente
# Copie para `.env` (ou `.env.local`) e preencha. Nunca commite segredos.

# ── Supabase (cliente, expostas ao browser) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (servidor — NUNCA expor ao cliente) ─────────────────────────────
# Ignora RLS; usar só em src/server/**.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (F3) ──────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── IA (F3) ──────────────────────────────────────────────────────────────────
AI_PROVIDER_API_KEY=

# ── Billing / Stripe (F4) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
