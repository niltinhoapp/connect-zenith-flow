# ConnectWeb Automations — variáveis de ambiente
# Copie para `.env` (ou `.env.local`) e preencha. Nunca commite segredos.

# ── Supabase (cliente, expostas ao browser) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (servidor — NUNCA expor ao cliente) ─────────────────────────────
# Ignora RLS; usar só em src/server/** e no worker (scripts/worker.mjs).
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (F3.1) ────────────────────────────────────────────────
# App da Meta (developers.facebook.com). Secrets das Edge Functions:
#   supabase secrets set META_APP_ID=... META_APP_SECRET=... \
#     WHATSAPP_WEBHOOK_VERIFY_TOKEN=... WHATSAPP_APP_SECRET=... WHATSAPP_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
# App Secret p/ validar a assinatura X-Hub-Signature-256 do webhook (= META_APP_SECRET).
WHATSAPP_APP_SECRET=
# String secreta que você define e repete no painel da Meta ao assinar o webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versão do Graph API (opcional; default v21.0). Usada pela function e pelo worker.
WHATSAPP_GRAPH_VERSION=v21.0
# Embedded Signup (SDK do Facebook no cliente) — expostos ao browser:
VITE_META_APP_ID=
VITE_META_CONFIG_ID=

# ── IA — AI Automation Copilot (F3.3) ────────────────────────────────────────
# "Gerar com IA" no módulo Automações: gera fluxos a partir de linguagem natural
# (Claude Opus 5) via a Edge Function `ai-generate-flow`. A chave é um SECRET do
# projeto — só o servidor a usa; NUNCA é exposta ao browser.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy ai-generate-flow
ANTHROPIC_API_KEY=

# ── Billing / Stripe (F4) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
